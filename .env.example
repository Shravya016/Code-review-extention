# Copy to .env and adjust. For local API + worker (see README).

DATABASE_URL=postgresql+asyncpg://codereview:codereview@localhost:5432/codereview
REDIS_URL=redis://localhost:6379/0

API_KEYS=devkey:00000000-0000-0000-0000-000000000001

# Chat (code review) — Ollama + DeepSeek
DEFAULT_LLM_PROVIDER=ollama
DEFAULT_LLM_MODEL=deepseek-coder:6.7b
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Pinecone memory (no OpenAI required)
PINECONE_API_KEY=your-pinecone-key
PINECONE_INDEX=your-index-name
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768

# Optional OpenAI path instead of Ollama embeddings:
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSION=1536
# OPENAI_API_KEY=sk-...

# WEBHOOK_DEFAULT_ORG_ID=00000000-0000-0000-0000-000000000001
