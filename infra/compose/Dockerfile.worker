FROM python:3.12-slim

WORKDIR /app
RUN pip install --no-cache-dir uv

COPY . /app

RUN cd /app && uv sync --project apps/worker --no-dev

ENV PYTHONPATH=/app/apps/worker/src:/app/packages/python-common/src

WORKDIR /app

CMD ["uv", "run", "--project", "apps/worker", "python", "-m", "codereview_worker.main"]
